#!/usr/bin/env bash
# chezmoi:template:left-delimiter="# [[" right-delimiter=]]

# Script used to list all updates for manually installed items

# Exit on error. Append || true if you expect an error.
set -o errexit
# Exit on error inside any functions or subshells.
set -o errtrace
# Do not allow use of undefined vars. Use ${VAR:-} to use an undefined VAR
set -o nounset
# Catch the error in case mysqldump fails (but gzip succeeds) in `mysqldump |gzip`
set -o pipefail
# Turn on traces, useful while debugging but commented out by default
#set -o xtrace

function to_release_url() {
  local url=$1
  local tag=$2
  if [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)/archive/refs/tags/(.+).tar.gz$ ]] || [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)/releases/download/(.+)/.*.tar.gz$ ]]; then
    echo "https://github.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/releases/tag/${BASH_REMATCH[3]}"
  elif [[ "$url" =~ ^https://github.com/([^/]*)/([^/]*).git$ ]]; then
    echo "https://github.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/releases/tag/$tag"
  elif [[ "$url" =~ ^https://nodejs.org/dist/v([^/]+)/node-.*$ ]]; then
    echo "https://github.com/nodejs/node/releases/tag/v${BASH_REMATCH[1]}"
  fi
}

echo Updating Homebrew
user=# [[ .brew.install_user | quote ]]
if [ "$user" != "" ]; then
  su "$user" -c "brew update"
else
  brew update
fi

echo Formulae
brew outdated --json | jq --compact-output '.formulae[]  | select(.pinned == false) | {name, current_version, installed_versions}' | while IFS= read -r line; do
  name="$(echo "$line" | jq --raw-output '.name')"
  info="$(brew info --formulae --json=v2 "$name")"
  if [[ "$(echo "$info" | jq '.formulae[].installed[].installed_on_request')" == "true" ]]; then
    oldVersion="$(echo "$line" | jq --raw-output '.installed_versions[0]')"
    newVersion="$(echo "$line" | jq --raw-output '.current_version')"
    tag="$(echo "$info" | jq --raw-output '.formulae[].urls.stable.tag')"
    release_url="$(to_release_url "$(echo "$info" | jq --raw-output '.formulae[].urls.stable.url')" "$tag")"
    if [[ "$release_url" == "" ]]; then
      release_url="$(to_release_url "$(echo "$info" | jq --raw-output '.formulae[].urls.head.url')" "$tag")"
    fi

    if [[ "$release_url" == "" ]]; then
      domains="$(echo "$info" | jq --raw-output '[[(.formulae[].urls.head?.url // ""), (.formulae[].urls.stable.url)] | .[] | select(. != "") | sub("^[^:]*://";"") | sub("/.*$";"")] | join(" or ")')"
      printf '%s %s -> %s (%s)\n' "$name" "$oldVersion" "$newVersion" "$domains"
    else
      printf '%s %s -> \e]8;;%s\e\\%s\e]8;;\e\\\n' "$name" "$oldVersion" "$release_url" "$newVersion"
    fi
  fi
done

echo Casks
brew outdated --json | jq --raw-output '.casks[] | "\(.name) \(.installed_versions[0]) -> \(.current_version)"'

echo Pinned formulas
brew list --pinned

